# Template for the signing variables, see docs/development.md#release-builds.
# Copy to signing-app.env (app signing key) or signing-upload.env (Google Play
# upload key), fill in the values and load with: set -a; source signing-app.env; set +a
# Never commit the copies, Git ignores them.
OPENWRIST_KEYSTORE=/path/to/openwrist-release.jks
OPENWRIST_KEYSTORE_PASSWORD=
OPENWRIST_KEY_ALIAS=openwrist
OPENWRIST_KEY_PASSWORD=
